modules = ["nodejs-20", "bash", "web", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Push to UIScope-jvm"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run UIScope (VNC)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Serve Docs"

[[workflows.workflow]]
name = "Push to UIScope-jvm"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/push-to-github.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Run UIScope (VNC)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-uiscope.sh"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow]]
name = "Serve Docs"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m http.server 5000 --directory /home/runner/workspace/docs"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
