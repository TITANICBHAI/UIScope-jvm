CREATE TABLE IF NOT EXISTS watch_rules (
    id TEXT PRIMARY KEY NOT NULL,
    label TEXT NOT NULL,
    condition_type TEXT NOT NULL,
    target_resource_id TEXT,
    target_class_name TEXT,
    target_text TEXT,
    poll_interval_ms INTEGER NOT NULL DEFAULT 2000,
    created_at INTEGER NOT NULL
);

insertWatchRule:
INSERT OR REPLACE INTO watch_rules (id, label, condition_type, target_resource_id, target_class_name, target_text, poll_interval_ms, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllWatchRules:
SELECT * FROM watch_rules ORDER BY created_at DESC;

deleteWatchRule:
DELETE FROM watch_rules WHERE id = ?;

countWatchRules:
SELECT COUNT(*) FROM watch_rules;
