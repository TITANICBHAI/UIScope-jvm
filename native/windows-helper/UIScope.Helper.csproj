<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Classic (non-SDK) project on purpose: the helper builds with the Framework MSBuild that ships on
    every Windows runner/box (C:\Windows\Microsoft.NET\Framework64\v4.0.30319\MSBuild.exe) - no
    dotnet SDK, no targeting pack, no NuGet. System references resolve from the framework directory.
    That MSBuild knows ToolsVersion 2.0/3.5/4.0 only (15.0 produced warning MSB4132 on every build), and
    its compiler is C# 5: keep every source file free of C# 6+ syntax (?. $"" nameof => members).
    Sources stay pure ASCII so no code page can misread them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>UIScope.Helper</AssemblyName>
    <RootNamespace>UIScope.Helper</RootNamespace>
    <OutputPath>bin\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Win32Manifest>app.manifest</Win32Manifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ErrorReport>none</ErrorReport>
    <DebugType>none</DebugType>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Json.cs" />
    <Compile Include="Native.cs" />
    <Compile Include="Activation.cs" />
    <Compile Include="Inspector.cs" />
    <Compile Include="Host.cs" />
    <Compile Include="PickMode.cs" />
    <Compile Include="SelfTest.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets" />
</Project>
